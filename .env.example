# Local secrets — never commit real keys
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public profile links (leave blank to show configuration placeholders in the UI)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_USERNAME=
NEXT_PUBLIC_CV_URL=

# Optional GitHub API token to raise rate limits for the repository section
GITHUB_TOKEN=

# Contact form — the API will not pretend a message was sent unless all three are set
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
